{
  "name": "client-project-tracker",
  "version": "1.0.0",
  "description": "Client Project Tracker - Full Stack Express & React App",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/server.js",
    "build": "npm --prefix client run build",
    "vercel-build": "prisma generate && prisma db push && node seed/seed.js && npm --prefix client run build",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node seed/seed.js",
    "test:api": "node scripts/test-api.js"
  },
  "keywords": [
    "express",
    "react",
    "prisma",
    "zod",
    "project-tracker"
  ],
  "author": "Full Stack Developer",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
